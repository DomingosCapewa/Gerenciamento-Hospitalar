{
  "Authentication": {
    "Authority": "http://localhost:8080/realms/hospital",
    "Audience": "hospital-api",
    "RequireHttpsMetadata": false
  },
  "ReverseProxy": {
    "Routes": {
      "agendamentos": {
        "ClusterId": "agendamentos-cluster",
        "Match": { "Path": "/agendamentos/{**catch-all}" }
      },
      "cadastro": {
        "ClusterId": "agendamentos-cluster",
        "Match": { "Path": "/api/cadastro/{**catch-all}" }
      },
      "clinica": {
        "ClusterId": "clinica-cluster",
        "Match": { "Path": "/clinica/{**catch-all}" }
      },
      "cirurgico": {
        "ClusterId": "cirurgico-cluster",
        "Match": { "Path": "/cirurgico/{**catch-all}" }
      }
    },
    "Clusters": {
      "agendamentos-cluster": {
        "Destinations": {
          "d1": { "Address": "https://localhost:7264/" }
        }
      },
      "clinica-cluster": {
        "Destinations": {
          "d1": { "Address": "https://localhost:7265/" }
        }
      },
      "cirurgico-cluster": {
        "Destinations": {
          "d1": { "Address": "https://localhost:7108/" }
        }
      }
    }
  }
}
