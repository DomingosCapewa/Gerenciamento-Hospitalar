{
  "id": "hospital",
  "realm": "hospital",
  "enabled": true,
  "sslRequired": "none",
  "loginTheme": "hospital",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "clients": [
    {
      "id": "hospital-api-client-id",
      "clientId": "hospital-api",
      "name": "Hospital API",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "bearerOnly": false,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["*"],
      "webOrigins": ["*"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    }
  ],
  "roles": {
    "realm": [
      { "name": "Usuario" },
      { "name": "Medico" },
      { "name": "Admin" }
    ]
  },
  "defaultRoles": ["offline_access", "uma_authorization", "Usuario"],
  "users": [
    {
      "username": "user",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Usuario",
      "lastName": "Demo",
      "credentials": [{"type":"password","value":"user","temporary":false}],
      "realmRoles": ["Usuario"]
    },
    {
      "username": "medico",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Medico",
      "lastName": "Demo",
      "credentials": [{"type":"password","value":"medico","temporary":false}],
      "realmRoles": ["Medico"]
    },
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "Demo",
      "credentials": [{"type":"password","value":"admin","temporary":false}],
      "realmRoles": ["Admin"]
    }
  ]
}
